<?xml version="1.0" encoding="utf-8"?>
<!--
  App manifest for the Developer Mode Xbox build of River Flyer. CMake would
  generate a generic one; this gives the tile a name and art. The Publisher
  must match the signing certificate: CMake signs with its own temporary
  "CN=CMake" key, which is fine for sideloading in Developer Mode. A store
  submission would use a real identity and certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">

  <Identity Name="RiverFlyer.DevMode" Publisher="CN=CMake" Version="0.4.0.0" />
  <mp:PhoneIdentity PhoneProductId="8f2b7a4e-0c3d-4b7e-9a1f-5d6e7c8b9a01" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>River Flyer</DisplayName>
    <PublisherDisplayName>B. Graham</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-ca" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="RiverFlyer.App">
      <uap:VisualElements
        DisplayName="River Flyer"
        Description="Fly up the river, dodge the rocks, refuel at the pumps."
        BackgroundColor="#3A82DC"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#3A82DC" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
